# Copy to .env for local development. Every setting is read by api/app/config.py.
# In production (Render) these are set in the dashboard instead; see docs/DEPLOY.md.

# ---------- Core ----------
# development | production
ENVIRONMENT=development
# The admin's email: made an admin on every start (manages people in Settings)
OWNER_EMAIL=you@example.com
TIMEZONE=Asia/Kolkata
# Used by docker compose for the local db service
POSTGRES_PASSWORD=change-me
# Only needed when running the API outside Docker (uv run uvicorn ...);
# inside compose the app service builds its own URL. postgres:// URLs are accepted too.
DATABASE_URL=postgresql+psycopg://voxfin:change-me@localhost:5432/voxfin

# ---------- Accounts ----------
# dev = everyone is the admin, no login (local only); password = real accounts (production)
AUTH_MODE=dev
# Optional first password for the admin, from `cd api && uv run python -m app.auth hash-password`.
# Only used while the admin has no password; change it in the app afterwards.
# Keep the single quotes: the hash contains "$" characters.
OWNER_PASSWORD_HASH=''
SESSION_DAYS=90
# true = anyone with the URL can create an account
SIGNUP_ENABLED=true
# Voice/typed commands allowed per person per 10 minutes (protects the free AI quotas)
COMMANDS_PER_10_MINUTES=30

# ---------- Google sign-in (optional) ----------
# The app's public address; Google sends people back to PUBLIC_URL/api/auth/google/callback
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Local backups (docker compose backup service) ----------
BACKUP_KEEP_DAYS=14

# ---------- Voice (all optional) ----------
# Without keys, voice still works: the browser transcribes speech and a built-in rule parser
# understands it. With a Groq key the server transcribes (Whisper) and an LLM understands;
# Gemini is the backup LLM. Free keys: console.groq.com and aistudio.google.com.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model ids change on free tiers; override here if a default stops working.
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# GEMINI_LLM_MODEL=gemini-flash-lite-latest
