# Copy to .env for local development. Every setting is read by api/app/config.py.
# In production (Render) these are set in the dashboard instead; see docs/DEPLOY.md.

# ---------- Core ----------
# development | production
ENVIRONMENT=development
# The owner's email (shown in the app; used to find the owner's data)
OWNER_EMAIL=you@example.com
TIMEZONE=Asia/Kolkata
# Used by docker compose for the local db service
POSTGRES_PASSWORD=change-me
# Only needed when running the API outside Docker (uv run uvicorn ...);
# inside compose the app service builds its own URL. postgres:// URLs are accepted too.
DATABASE_URL=postgresql+psycopg://voxfin:change-me@localhost:5432/voxfin

# ---------- Auth ----------
# dev = trust every request as the owner (local only); password = required in production
AUTH_MODE=dev
# Argon2 hash from `cd api && uv run python -m app.auth hash-password`.
# Keep the single quotes: the hash contains "$" characters.
OWNER_PASSWORD_HASH=''
SESSION_DAYS=90

# ---------- Local backups (docker compose backup service) ----------
BACKUP_KEEP_DAYS=14

# ---------- AI providers (from M2) ----------
# GROQ_API_KEY=
# GEMINI_API_KEY=
