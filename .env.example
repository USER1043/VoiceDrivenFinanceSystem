# Copy to .env and fill in. Every setting is read by api/app/config.py.

# ---------- Core ----------
# development | production
ENVIRONMENT=development
# The only person allowed in
OWNER_EMAIL=you@example.com
TIMEZONE=Asia/Kolkata
# Used by docker compose for the db service
POSTGRES_PASSWORD=change-me
# Only needed when running the API outside Docker (uv run uvicorn ...);
# inside compose the app service builds its own URL.
DATABASE_URL=postgresql+psycopg://voxfin:change-me@localhost:5432/voxfin

# ---------- Auth ----------
# dev = trust every request as the owner (local only); cloudflare = required in production
AUTH_MODE=dev
# e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# The Access application's "Application Audience (AUD) Tag"
CF_ACCESS_AUD=
# Only for `docker compose --profile tunnel`
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- Backups ----------
BACKUP_KEEP_DAYS=14

# ---------- AI providers (from M2) ----------
# GROQ_API_KEY=
# GEMINI_API_KEY=
